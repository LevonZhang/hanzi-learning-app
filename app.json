{
  "expo": {
    "name": "字学堂 (HanziLearning)",
    "slug": "hanzi-learning-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/AppIcons/Icon-AppStore.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#FF7B6B"
    },
    "assetBundlePatterns": [
      "assets/**/*",
      "assets/js/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.hanzilearning",
      "buildNumber": "1",
      "privacyPolicyUrl": "https://hanzilearning.xyz/privacy",
      "eulaUrl": "https://hanzilearning.xyz/terms"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization"
    ],
    "experiments": {
      "newArchEnabled": true
    },
    "android": {
      "package": "com.example.hanzilearning"
    },
    "mac": {
      "bundleIdentifier": "com.example.hanzilearning",
      "backgroundColor": "#ffffff",
      "minWidth": 800,
      "minHeight": 600,
      "windowStyle": "tabbed",
      "windowEffects": ["titlebar", "selection"],
      "windowPosition": "center"
    }
  }
}
